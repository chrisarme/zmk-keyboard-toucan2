#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/toucan_screen.h>
#include <dt-bindings/zmk/toucan_artwork.h>


#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3
#define SET  4
#define MISC 5

/ {
	behaviors {
		screen: toucan_screen {
			compatible = "zmk,behavior-toucan-screen";
			#binding-cells = <1>;
			display-name = "Toucan Screen";
		};

		artwork: toucan_artwork {
			compatible = "zmk,behavior-toucan-artwork";
			#binding-cells = <1>;
			display-name = "Toucan Artwork";
		};

		// Enables holding the first mod-tap key
		// by performing a tap-release-hold sequence.
		// To use it: "&qt KEYCODE1 KEYCODE2"
		qt: quick_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "QUICK_TAP";
			#binding-cells = <2>;
			flavor = "hold-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			bindings = <&kp>, <&kp>;
		};
		
		tp: tap_prefered {
			compatible = "zmk,behavior-hold-tap";
			label = "TAP_PREFERRED";
			#binding-cells = <2>;
			flavor = "tap-preferred";
			tapping-term-ms = <200>;
			quick-tap-ms = <200>;
			bindings = <&kp>, <&kp>;
		};
		
		td0: tap_dance_win_space {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp SPACE>, <&kp LGUI>;
        };
		
		td1: tap_dance_SYM_MISC {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo SYM>, <&mo MISC>;
        };
		
		//td2: tap_dance_enter_fn2 {
        //    compatible = "zmk,behavior-tap-dance";
        //    #binding-cells = <0>;
        //    tapping-term-ms = <200>;
        //    bindings = <&kp ENTER>, <&mo FROWFNC2>;
        //};
		
		td3: tap_dance_ctrl_sym1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LCTRL>, <&sl 3>;
        };
		
		//td4: tap_dance_sticky_ctrl {
        //    compatible = "zmk,behavior-tap-dance";
        //    #binding-cells = <0>;
        //    tapping-term-ms = <200>;
        //    bindings = <&sk LCTRL>, <&kp LCTRL>;
        //};
	};

    combos {
        compatible = "zmk,combos";

        screen_next {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&screen TOUCAN_SCREEN_NEXT>;
            layers = <SET>;
        };
    };

	macros {
		// sometimes my device thinks a modifier is being held down
		// pressing all modifiers fixes it.
		unstick: unstick {
			label = "ZM_unstick";
			compatible = "zmk,behavior-macro";
			#binding-cells = <0>;
			bindings = <&kp LSHIFT &kp RSHIFT &kp LCTRL &kp RCTRL &kp LALT &kp RALT &kp LGUI &kp RGUI>;
		};
		
		mc_rebuild: mc_rebuild {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
			wait-ms = <10>;
            bindings
                = <&kp LC(K)>
                , <&macro_wait_time 50>
                , <&kp LC(LS(B))>
                ;
        };
		
		mc_clean: mc_clean {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
			wait-ms = <10>;
            bindings
                = <&kp LC(K)>
                , <&macro_wait_time 50>
                , <&kp LC(LS(C))>
                ;
        };
		
		mc_toggle_comment: mc_toggle_comment {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
			wait-ms = <10>;
            bindings
                = <&kp LC(K)>
                , <&macro_wait_time 50>
                , <&kp LC(FSLH)>
                ;
        };
	};

    // conditional_layers {
    //     compatible = "zmk,conditional-layers";
	//     tri_layer {
    //         if-layers = <1 2>;
    //         then-layer = <3>;
    //     };
    // };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp TAB   &kp Q &kp W &kp F &kp P &kp G         &kp J &kp L  &kp U     &kp Y   &kp SEMI &kp BSPC
                &kp LSHFT &kp A &kp R &kp S &kp T &kp D         &kp H &kp N  &kp E     &kp I   &kp O    &kp SQT
                &kp LCTRL &kp Z &kp X &kp C &kp V &kp B         &kp K &kp M  &kp COMMA &kp DOT &kp FSLH &kp KP_ENTER
                                &kp LALT &mo NAV &td0           &kp RET  &kp MINUS &td1
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp F5  &kp C_PP   &kp HOME  &kp UP    &kp END   &kp BSPC       &kp PSCRN    &kp KP_N7      &kp KP_N8 &kp KP_N9    &trans &kp DEL
                &trans  &kp PG_UP  &kp LEFT  &kp DOWN  &kp RIGHT &kp LBKT       &kp RBKT     &kp KP_N4      &kp KP_N5 &kp KP_N6 &trans &trans
                &trans  &kp PG_DN  &kp EQUAL &kp LT    &kp GT    &kp ESC        &kp LG(LS(S)) &kp KP_N1      &kp KP_N2 &kp KP_N3 &trans &trans
                                        	 &kp LGUI  &trans    &mo SET        &kp RALT     &kp KP_N0      &mo ADJ 
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &trans &kp F1   &kp F2   &kp F3   &kp F4   &kp F5      &kp F6 &kp F7  &kp F8 &kp F9 &kp F10 &kp F11
                &trans &kp N1   &kp N2   &kp N3   &kp N4   &kp N5      &kp N6 &kp N7  &kp N8  &kp N9 &kp N0 &kp F12 
                &trans &studio_unlock &trans &trans &kp KP_MINUS &kp UNDER      &kp EQUAL &kp PLUS  &kp LPAR &kp RPAR &kp BSLH &kp GRAVE
                                	  &trans &trans &trans             &trans   &trans    &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &trans   &trans &kp F7 &kp F8 &kp F9 &kp F12   &kp C_VOL_DN &kp C_MUTE  &kp C_VOL_UP &trans &trans &kp BSPC
                &trans  &trans &kp F4 &kp F5 &kp F6 &kp F11   &trans       &trans      &trans       &trans &trans &trans
                &trans  &trans &kp F1 &kp F2 &kp F3 &kp F10   &trans       &trans      &trans       &trans &trans &trans
                                   &kp LGUI &trans  &kp SPACE   &trans &trans &trans
            >;
        };
    	set  {
            display-name = "SET";
            bindings = <
                &bootloader    &none         &trans        &trans        &artwork TOUCAN_ARTWORK_PREV &artwork TOUCAN_ARTWORK_NEXT &trans &trans &trans &trans &trans &trans
                &bt BT_CLR     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 5       &trans      &trans       &trans &trans &trans
                &studio_unlock &kp CAPS      &kp KP_NUMLOCK  &trans      &trans        &trans        &trans             &trans      &trans       &trans &trans &trans
                                   			 &kp LGUI      &trans        &trans        &kp RET &kp RCTRL &trans
            >;
        };

        misc {
            display-name = "MISC";
            bindings = <
                &trans  &none      &none      &none        &none &none     &none  &none   &trans     &trans      &trans            &kp APPLY_MODS(MOD_RCTL, F12)
                &trans  &kp C_NEXT &kp C_PP   &kp C_VOL_UP &none &none     &none  &trans  &trans     &mc_rebuild &kp LC(MINUS)     &trans
                &trans  &kp C_PREV &kp C_MUTE &kp C_VOL_DN &none &none     &none  &trans  &kp LC(B)  &mc_clean   &kp LC(LS(MINUS)) &trans
                                   &none  &none &none                      &kp RET   &trans   &none
			>;
        };

        extra_3 {
                status = "reserved";
        };
    };
};
